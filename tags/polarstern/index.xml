      <title>PS156: Geophysics Arctic Ocean Expedition on RV Polarstern</title>
      <link>https://alexgag11.github.io/blog/ps156-arctic-ocean/</link>
      <pubDate>Thu, 15 Oct 2026 00:00:00 +0000</pubDate>
      <guid>https://alexgag11.github.io/blog/ps156-arctic-ocean/</guid>
      <description>&lt;table&gt;
