    <item>
      <title>KH7010: i2B Arctic Ocean Expedition on RV Kronprins Haakon</title>
      <link>https://alexgag11.github.io/blog/kh7010-arctic-ocean/</link>
      <pubDate>Sat, 16 Aug 2025 00:00:00 +0000</pubDate>
      <guid>https://alexgag11.github.io/blog/kh7010-arctic-ocean/</guid>
      <description>&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
