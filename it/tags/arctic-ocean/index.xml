&lt;script&gt;
(() =&gt; {
  document.querySelectorAll(&#39;.photo-gallery-wrap:not([data-ready])&#39;).forEach(wrap =&gt; {
    wrap.dataset.ready = &#39;&#39;;
    const links = [...wrap.querySelectorAll(&#39;.photo-gallery a&#39;)];
    const viewer = wrap.querySelector(&#39;.photo-viewer&#39;);
    const img = viewer.querySelector(&#39;img&#39;);
    const caption = viewer.querySelector(&#39;figcaption&#39;);
    let index = 0;

    const show = i =&gt; {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.href;
      img.alt = link.dataset.caption;
      const text = link.dataset.caption;
      caption.textContent = (text ? text + &#39; · &#39; : &#39;&#39;) + (index + 1) + &#39; / &#39; + links.length;
      
      new Image().src = links[(index + 1) % links.length].href;
    };

    links.forEach((link, i) =&gt; link.addEventListener(&#39;click&#39;, e =&gt; {
      e.preventDefault();
      show(i);
      viewer.showModal();
    }));

    viewer.querySelector(&#39;.pv-prev&#39;).addEventListener(&#39;click&#39;, () =&gt; show(index - 1));
    viewer.querySelector(&#39;.pv-next&#39;).addEventListener(&#39;click&#39;, () =&gt; show(index + 1));
    viewer.querySelector(&#39;.pv-close&#39;).addEventListener(&#39;click&#39;, () =&gt; viewer.close());
    
    viewer.addEventListener(&#39;click&#39;, e =&gt; { if (e.target === viewer || e.target.tagName === &#39;FIGURE&#39;) viewer.close(); });
    viewer.addEventListener(&#39;keydown&#39;, e =&gt; {
      if (e.key === &#39;ArrowLeft&#39;) show(index - 1);
      if (e.key === &#39;ArrowRight&#39;) show(index + 1);
    });

    
    let startX = null;
    viewer.addEventListener(&#39;touchstart&#39;, e =&gt; { startX = e.touches[0].clientX; }, { passive: true });
    viewer.addEventListener(&#39;touchend&#39;, e =&gt; {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) &gt; 50) show(index + (dx &lt; 0 ? 1 : -1));
      startX = null;
    });
  });
})();
&lt;/script&gt;

